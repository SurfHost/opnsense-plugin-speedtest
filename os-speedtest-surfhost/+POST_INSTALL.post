# Carry over the history of os-speedtest-community on the first install. Its
# CSV is not a packaged file, so it survives removing that plugin; the import
# skips rows it already has, so running it again on an upgrade is harmless.
if [ -f /usr/local/opnsense/scripts/OPNsense/speedtest/speedtest.csv ]; then
	echo "Importing the os-speedtest-community history"
	/usr/local/bin/python3 \
	    /usr/local/opnsense/scripts/OPNsense/SpeedtestSurfHost/speedtest.py import || :
fi
